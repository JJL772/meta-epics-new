From a8f214a215b9e07b1c37879c242688b31dfb83f2 Mon Sep 17 00:00:00 2001
From: Tyler Johnson <tylerjohnson3208@gmail.com>
Date: Tue, 21 Jul 2026 16:55:27 -0700
Subject: [PATCH] Break up rule to resolve pattern rule errors on autosave and
 archive files

---
 configure/RULES.archive  | 11 +++++++++--
 configure/RULES.autosave | 11 +++++++++--
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/configure/RULES.archive b/configure/RULES.archive
index 0349fabea..e549119e5 100644
--- a/configure/RULES.archive
+++ b/configure/RULES.archive
@@ -54,9 +54,16 @@ $(INSTALL_ARCHIVE)/%:	%
 	@$(ECHO) "Installing archive file $@"
 	@$(INSTALL) -d -m 644 $< $(@D)
 
-$(COMMON_DIR)/%.archive %.archive: %.sub-arch
+$(COMMON_DIR)/%.archive: %.sub-arch
 	@$(RM) $(notdir $@)$(DEP)
-	$(MKMF) -m $(notdir $@)$(DEP) $(ARCHIVE_INCLUDES) $@ $< 
+	$(MKMF) -m $(notdir $@)$(DEP) $(ARCHIVE_INCLUDES) $@ $<
+	@$(ECHO) "Inflating archive file from $<"
+	@$(RM) $@
+	$(MSI3_15) $(ARCHIVEFLAGS) -S$< > $@
+
+%.archive: %.sub-arch
+	@$(RM) $(notdir $@)$(DEP)
+	$(MKMF) -m $(notdir $@)$(DEP) $(ARCHIVE_INCLUDES) $@ $<
 	@$(ECHO) "Inflating archive file from $<"
 	@$(RM) $@
 	$(MSI3_15) $(ARCHIVEFLAGS) -S$< > $@
diff --git a/configure/RULES.autosave b/configure/RULES.autosave
index 3718e1a8f..4dfe1690f 100644
--- a/configure/RULES.autosave
+++ b/configure/RULES.autosave
@@ -51,9 +51,16 @@ $(INSTALL_AUTOSAVE)/%:	%
 	@$(ECHO) "Installing autosave file $@"
 	@$(INSTALL) -d -m 644 $< $(@D)
 
-$(COMMON_DIR)/%.req %.req: %.sub-req
+$(COMMON_DIR)/%.req: %.sub-req
 	@$(RM) $(notdir $@)$(DEP)
-	$(MKMF) -m $(notdir $@)$(DEP) $(AUTOSAVE_INCLUDES) $@ $< 
+	$(MKMF) -m $(notdir $@)$(DEP) $(AUTOSAVE_INCLUDES) $@ $<
+	@$(ECHO) "Inflating autosave request from $<"
+	@$(RM) $@
+	$(MSI3_15) $(AUTOSAVEFLAGS) -S$< > $@
+
+%.req: %.sub-req
+	@$(RM) $(notdir $@)$(DEP)
+	$(MKMF) -m $(notdir $@)$(DEP) $(AUTOSAVE_INCLUDES) $@ $<
 	@$(ECHO) "Inflating autosave request from $<"
 	@$(RM) $@
 	$(MSI3_15) $(AUTOSAVEFLAGS) -S$< > $@
